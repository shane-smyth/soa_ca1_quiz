@page "/flag-quiz"
@rendermode InteractiveServer
@inject FlagGame quiz

<PageTitle>Flag Quiz</PageTitle>

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h2 class="text-center mb-4">Country Quiz</h2>

            @if (isLoading)
            {
                <div class="text-center">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-3 text-muted">Loading flags...</p>
                </div>
            }
            else if (errorMessage != "")
            {
                <div class="alert alert-danger">@errorMessage</div>
                <div class="text-center">
                    <button class="btn btn-primary" @onclick="StartGame">Try again</button>
                    <a href="/" class="btn btn-outline-secondary">Home</a>
                </div>
            }
            else if (!started)
            {
                <div class="card text-center">
                    <div class="card-body">
                        <p class="card-text">You will be shown a flag. Search for the country it belongs to.</p>
                        <button class="btn btn-primary" @onclick="StartGame">Start quiz</button>
                    </div>
                </div>
            }
            else if (shownCountry == null)
            {
                <div class="card text-center">
                    <div class="card-body">
                        <h3 class="card-title">Quiz finished!</h3>
                        <p class="card-text fs-4">You scored @quiz.Score out of @quiz.TotalQuestions</p>
                        <button class="btn btn-primary" @onclick="StartGame">Play again</button>
                        <a href="/" class="btn btn-outline-secondary">Home</a>
                    </div>
                </div>
            }
            else
            {
                <div class="card">
                    <div class="card-header d-flex justify-content-between">
                        <span>Flag @questionNumber of @quiz.TotalQuestions</span>
                        <span>Score: @quiz.Score</span>
                    </div>
                    <div class="card-body text-center">
                        <h5 class="mb-3">Which country does this flag belong to?</h5>
                        <img src="@shownCountry.FlagUrl" class="img-fluid border mb-4" style="max-height: 200px;" alt="Flag" />

                        @if (!answered)
                        {
                            <div class="position-relative text-start mx-auto" style="max-width: 400px;">
                                <input class="form-control" placeholder="Type a country name..."
                                       value="@searchText" @oninput="OnInput" @onkeydown="OnKeyDown" />

                                @if (suggestions.Count > 0)
                                {
                                    <div class="list-group position-absolute w-100" style="z-index: 10;">
                                        @foreach (string name in suggestions)
                                        {
                                            <button type="button" class="list-group-item list-group-item-action"
                                                    @onclick="() => ChooseSuggestion(name)">@name</button>
                                        }
                                    </div>
                                }
                            </div>

                            @if (message != "")
                            {
                                <div class="text-danger mt-2">@message</div>
                            }

                            <div class="mt-3">
                                <button class="btn btn-primary" @onclick="Submit">Submit guess</button>
                                <button class="btn btn-outline-secondary" @onclick="Skip">Skip</button>
                            </div>
                        }
                        else
                        {
                            <div class="mt-2">
                                @if (wasCorrect)
                                {
                                    <div class="alert alert-success">Correct! It is @shownCountry.Name.</div>
                                }
                                else
                                {
                                    <div class="alert alert-danger">Wrong! It was @shownCountry.Name.</div>
                                }

                                <button class="btn btn-primary" @onclick="Next">
                                    @(quiz.IsFinished ? "See results" : "Next flag")
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private bool isLoading = false;
    private bool started = false;
    private string errorMessage = "";

    private Country? shownCountry;
    private int questionNumber = 1;
    private bool answered = false;
    private bool wasCorrect = false;

    private string searchText = "";
    private List<string> suggestions = new List<string>();
    private string message = "";

    private async Task StartGame()
    {
        isLoading = true;
        errorMessage = "";

        try
        {
            await quiz.StartAsync();
            shownCountry = quiz.CurrentCountry;
            questionNumber = 1;
            ResetGuess();
            started = true;
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception)
        {
            errorMessage = "Something went wrong. Please try again.";
        }

        isLoading = false;
    }

    // Runs every time the player types a letter.
    private void OnInput(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? "";
        suggestions = quiz.Search(searchText);
        message = "";
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Submit();
        }
    }

    // The player clicked one of the suggested countries.
    private void ChooseSuggestion(string name)
    {
        searchText = name;
        suggestions.Clear();
    }

    private void Submit()
    {
        if (answered)
        {
            return;
        }

        // The guess must be a real country, so typos are not counted as wrong answers.
        if (!quiz.IsValidCountry(searchText))
        {
            message = "Please choose a country from the list.";
            return;
        }

        wasCorrect = quiz.Answer(searchText);
        answered = true;
        suggestions.Clear();
        message = "";
    }

    private void Skip()
    {
        wasCorrect = quiz.Answer("");   // an empty guess is always wrong
        answered = true;
        suggestions.Clear();
        message = "";
    }

    private void Next()
    {
        questionNumber++;
        ResetGuess();
        shownCountry = quiz.CurrentCountry;
    }

    private void ResetGuess()
    {
        answered = false;
        searchText = "";
        suggestions.Clear();
        message = "";
    }
}
