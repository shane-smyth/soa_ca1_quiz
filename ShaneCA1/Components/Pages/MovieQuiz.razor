@page "/movie-quiz"
@rendermode InteractiveServer
@inject MovieGame game

<PageTitle>Movie Quiz</PageTitle>

<div class="container mt-5">
    <div class="row">
        <div class="col-md-10 offset-md-1">
            <h2 class="text-center mb-4">Movie Quiz</h2>

            @if (isLoading)
            {
                <div class="text-center">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-3 text-muted">Loading movies...</p>
                </div>
            }
            else if (errorMessage != "")
            {
                <div class="alert alert-danger">@errorMessage</div>
                <div class="text-center">
                    <button class="btn btn-primary" @onclick="StartGame">Try again</button>
                    <a href="/" class="btn btn-outline-secondary">Home</a>
                </div>
            }
            else if (!started)
            {
                <div class="card text-center">
                    <div class="card-body">
                        <p class="card-text">
                            You will see two movies. The first movie's rating is shown.
                            Guess if the second movie is rated higher or lower.
                        </p>
                        <button class="btn btn-primary" @onclick="StartGame">Start quiz</button>
                    </div>
                </div>
            }
            else if (shownFirst == null || shownSecond == null)
            {
                <div class="card text-center">
                    <div class="card-body">
                        <h3 class="card-title">Quiz finished!</h3>
                        <p class="card-text fs-4">You scored @game.Score out of @game.TotalRounds</p>
                        <button class="btn btn-primary" @onclick="StartGame">Play again</button>
                        <a href="/" class="btn btn-outline-secondary">Home</a>
                    </div>
                </div>
            }
            else
            {
                Movie first = shownFirst;
                Movie second = shownSecond;

                <div class="d-flex justify-content-between mb-3">
                    <span>Round @roundNumber of @game.TotalRounds</span>
                    <span>Score: @game.Score</span>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="card h-100 text-center">
                            <img src="@first.PosterUrl" class="card-img-top" style="max-height: 350px; object-fit: contain;" alt="Poster for @first.Title" />
                            <div class="card-body">
                                <h5 class="card-title">@first.ToString()</h5>
                                <p class="card-text fs-4">Rating: <strong>@first.Rating.ToString("0.0")</strong></p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100 text-center">
                            <img src="@second.PosterUrl" class="card-img-top" style="max-height: 350px; object-fit: contain;" alt="Poster for @second.Title" />
                            <div class="card-body">
                                <h5 class="card-title">@second.ToString()</h5>
                                <p class="card-text fs-4">Rating: <strong>@(answered ? second.Rating.ToString("0.0") : "?")</strong></p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-4">
                    @if (!answered)
                    {
                        <p class="lead">Is <strong>@second.Title</strong> rated higher or lower than <strong>@first.Title</strong>?</p>
                        <button class="btn btn-success btn-lg me-2" @onclick="() => Guess(true)">Higher</button>
                        <button class="btn btn-danger btn-lg" @onclick="() => Guess(false)">Lower</button>
                    }
                    else
                    {
                        if (wasCorrect)
                        {
                            <div class="alert alert-success">Correct! @second.Title is rated @(second.Rating > first.Rating ? "higher" : "lower").</div>
                        }
                        else
                        {
                            <div class="alert alert-danger">Wrong! @second.Title is rated @(second.Rating > first.Rating ? "higher" : "lower").</div>
                        }

                        <button class="btn btn-primary" @onclick="Next">
                            @(game.IsFinished ? "See results" : "Next round")
                        </button>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private bool isLoading = false;
    private bool started = false;
    private string errorMessage = "";

    private Movie? shownFirst;
    private Movie? shownSecond;
    private int roundNumber = 1;
    private bool answered = false;
    private bool wasCorrect = false;

    private async Task StartGame()
    {
        isLoading = true;
        errorMessage = "";

        try
        {
            await game.StartAsync();
            shownFirst = game.FirstMovie;
            shownSecond = game.SecondMovie;
            roundNumber = 1;
            answered = false;
            started = true;
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception)
        {
            errorMessage = "Something went wrong. Please try again.";
        }

        isLoading = false;
    }

    private void Guess(bool guessedHigher)
    {
        wasCorrect = game.Guess(guessedHigher);
        answered = true;
    }

    private void Next()
    {
        answered = false;
        roundNumber++;
        shownFirst = game.FirstMovie;
        shownSecond = game.SecondMovie;
    }
}
