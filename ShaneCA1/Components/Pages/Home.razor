@page "/"

<PageTitle>Quiz - Home</PageTitle>

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="text-center">
                <h1 class="mb-4">Welcome to Quiz App</h1>
                <p class="lead text-muted mb-5">Play either the Country Quiz or the Movie Quiz </p>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="card h-100">
                            <img src="images/country.png" class="card-img-top" alt="World Map">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">Country Quiz</h5>
                                <p class="card-text">Test your knowledge on different countries flags.</p>
                                <a href="country-quiz" class="btn btn-primary mt-auto">Play Country Quiz</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100">
                            <img src="images/cinema.png" class="card-img-top" alt="Cinema">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">Movie Quiz</h5>
                                <p class="card-text">Do you know which movie has a higher rating?</p>
                                <a href="movie-quiz" class="btn btn-primary mt-auto">Play Movie Quiz</a>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>