@page "/"

<PageTitle>Quiz - Home</PageTitle>

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <div class="text-center mb-5">
                <h1 class="mb-3">Welcome to Quiz App</h1>
                <p class="lead text-muted">Test your knowledge with our quizzes.</p>
                <p class="lead text-muted">Play either the Country Quiz or the Movie Quiz.</p>
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <div class="card h-100">
                        <div style="height: 250px; overflow: hidden; background-color: #f8f9fa; display: flex; align-items: center; justify-content: center;">
                            <img src="images/country.png" class="img-fluid" style="max-height: 100%; max-width: 100%; object-fit: contain;" alt="World Map">
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">Flag Quiz</h5>
                            <p class="card-text">Test your knowledge on different countries flags.</p>
                            <a href="flag-quiz" class="btn btn-primary mt-auto">Play Flag Quiz</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card h-100">
                        <div style="height: 250px; overflow: hidden; background-color: #f8f9fa; display: flex; align-items: center; justify-content: center;">
                            <img src="images/cinema.png" class="img-fluid" style="max-height: 100%; max-width: 100%; object-fit: contain;" alt="Cinema">
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">Movie Quiz</h5>
                            <p class="card-text">Do you know which movie has a higher rating?</p>
                            <a href="movie-quiz" class="btn btn-primary mt-auto">Play Movie Quiz</a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>